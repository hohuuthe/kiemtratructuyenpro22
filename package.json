{
  "name": "online-exam-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "test:word-import-release": "node scripts/check-word-import-release.mjs",
    "prebuild": "node scripts/mathtype-preview-check.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "migrate:neon": "node scripts/migrate-to-neon.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:interactive-board-release": "node --check src/main.js && node --check src/interactive-board-ui.js && node --check workers/interactive-board-worker.js && node --import tsx --test tests/interactive-board-security.test.ts",
    "release:interactive-board:check": "npm run test:interactive-board-release && npm run lint && npm run build",
    "deploy:interactive-board-worker": "npx wrangler deploy --config wrangler.board.toml",
    "test:qr-cards": "node --import tsx --test tests/qr-answer-cards.test.ts",
    "release:qr-cards:check": "node --check src/qr-card-orientation.js && node --check src/qr-answer-cards-ui.js && npm run test:qr-cards && npm run lint && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "@google/genai": "^1.29.0",
    "@neondatabase/serverless": "^1.2.0",
    "@smithy/node-http-handler": "^4.8.1",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "html2canvas-pro": "2.5.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
